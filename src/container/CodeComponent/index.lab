(import _ form "macro")
(let codeComponentStyle (style.create {
            width:"100%",
            backgroundColor: "23|24|29|255",
            padding:"10px", 
        }
))

(let oneRow (style.create {
            color:"127|190|219|255",
            fontSize:"13px",
            height:"15px",
            lineHeight:"15px"
        }
))



(function (sliceCode str)
  (let sliceChar "(" )
  (let result [])
  (let temp "")
  (let isOperate false)
  (for (let i 0) (less i str.length) (+= i 1)

      (if (==  str[i]  sliceChar )
          (begin
            (set isOperate true)
            (+= temp str[i])
            (result.push temp)
            (set temp "")
          )
          (begin
            (if isOperate
                (begin
                  (if (&& (== str[i]  " ") (!= temp.length 0))
                      (begin
                        (result.push <span style={{color:"246|48|81|255"}}>{(+ " " temp " ")}</span>)
                        (set temp "")
                        (set isOperate false)
                      )
                      (+= temp str[i])
                  )
                )
                (+= temp str[i])
            )
          )
      )
  )

  (if isOperate
      (result.push <span style={{color:"255|0|0|255"}}> {temp} </span>)
      (result.push temp)
  )
  result
)


(function (CodeComponent props)
  (let code props.code)
  
  (let codeRows [])
  (let oneCodeRow "")
  (let wrapFlag "
")

  (for (let i 0) (less  i code.length) (+= i 1)
      (if (== code[i] wrapFlag)
          (begin 
            (codeRows.push oneCodeRow)
            (set oneCodeRow "")
          )
          (begin
            (+= oneCodeRow code[i])
          )
      )
  )
  (if (more oneCodeRow.length 0)
      (codeRows.push oneCodeRow)
  )

  (let showRows [])

  (for (let k 0) (less k codeRows.length) (+= k 1)
    (let oneRowCode codeRows[k])
    (showRows.push  <div className={oneRow}>{(sliceCode oneRowCode)}</div>)
  )

  <div className={codeComponentStyle}>
      {showRows}
  </div>
)


(export {
  CodeComponent
})

