(let LayoutStyle (style.create  {
    width:"100%",
    height:"100%",
    backgroundColor: "35|39|47|255",
    display:"flex",
    flexDirection:"column",
    color:"246|247|249|255"
}))

(let HeaderStyle (style.create  {
    width:"100%",
    height:"65px",
    border:"0px 0px 1px 0px"
}))

(let LayoutContent (style.create  {
    width:"100%",
    flexGrow :"1",
    overflow:"hidden"
}))



 (function (Layout props)
  <div className={LayoutStyle}>
    <div style={{width:"100%",height:"90px"}}>
      <div style={{width:"100%",height:"20px",lineHeight:"20px",fontSize:"14px",backgroundColor:"241|244|205|255",color:"255|0|0|255",overflow:"hidden"}}>
        demo，非最终版本，还有非常多要做的事情。比如：提高语言的性能问题，高性能的垃圾回收机制，3D，动画...
      </div>
      <div className={HeaderStyle}>
        <props.header></props.header>
      </div>
    </div>
    <div className={LayoutContent} >
       <props.content></props.content>
    </div>
  </div>
 )

(console.log "layout----------------------")

(export {
  Layout
})