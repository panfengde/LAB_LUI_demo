//常量
(let constantCodeString "12334 // 数字常量
\"hello word\" // 字符串常量
true // 布尔值常量
")


(let varDemo "(let aNumber 12345)
(let aString \"hello word\")
(let aBool true)
")

(let setDemo "(let aNumber 12345)
(set aNumber 54321)
")

(let coutDemo "(+ 1 2)
(- 10 5)
(* 2 3)
(/ 10 2)
")


(let functionStr "(function (add a)
  (+ a 200)
  (console.log \"执行完毕\")
)
#执行add方法
(add 100)
")


(let lambdaStr "(lambda (x) 
  (console.log x)
)")

(let ifStr "//定义一个名为add的函数
(if (> 10 20)
  (console.log \"true分之\")
  (console.log \"false分之\")
)")

(let whileStr "(let x 1)
(while (< x 10)
    (console.log x)
    (set x (+ x 1))
)
")

(let beginStr "(begin 
  (+ 1 1)
  (- 1 1)
  (* 2 2)
  (/ 2 2)
)
")

(let arrayStr "[1 2 3 4 5]
[10,20,30,40,50]")

(let dicStr "{
  name: \"张三\",
  age: 18,
  sex: \"男\"
}")


(let condStr "(let x 2)
(cond 
  ((== x 1) (console.log \"x = 1\" )
  ((== x 2) (console.log \"x = 2\" )
  ((== x 3) (console.log \"x = 3\" )
  (else (console.log \"x = 0\") )
)")

(let typeStr "(type 12345)
(type \"hello word\")
(type true)
(type [1 2 3])
(type {name:123})
")

(let classStr "(class Animal
    (function  (constructor name age)
        (set this.name name)
        (set this.age age)
    )
    (function (speak )
        (console.log this.name this.age)
    )
)"
)

(let newStr "(let aAnimal (new animal \"老三\" 4))")


(let exportStr "(let aAnimal (new animal \"老三\" 4))
(export {aAnimal:aAnimal})
")

(let importStr "(import {aAnimal} from \"./index.lab\")
(aAnimal.speak )
")

(let defineSyntaxStr "(define-syntax +=
  (syntax-rules ( )
     ((_ a b) (begin (set a (+ a b)) a))
     ((_ a b ...) (begin (set a (+ a b ...)) a))))
")

(export  {
  constantCodeString, 
  varDemo,
  setDemo,
  coutDemo,
  functionStr,
  lambdaStr,
  ifStr,
  whileStr,
  beginStr,
  arrayStr,
  dicStr,
  condStr,
  typeStr,
  classStr,
  newStr,
  exportStr,
  importStr,
  defineSyntaxStr,
})