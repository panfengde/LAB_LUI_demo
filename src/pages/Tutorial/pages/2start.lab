
(import {CodeComponent} from "../../../container/CodeComponent/index.lab")
(import {FoldCard} from "../../../components/FoldCard/index.lab")
(import {GetInfosStr,GetInfos,httpServeStr} from "./2startCodeStr.lab")

 (let aStyle (style.create  {
   fontSize:"16px",
   lineHeight:"24px"
}))

(let aTitle (style.create  {
   color:"255|155|55|255",
   margin:"10px 0px 10px 0px"
}))


(function (Divider )
  <div style={{margin:"20px 0px 20px 0px"}}></div>
)


(let content 
  <div className={aStyle}>
    <div className={aTitle}>开始</div>
    <div >新建一个文件，如index.lab。我们会在这个文件中编写代码。</div>
    <div > 你可以使用你喜欢的任意编辑器编写，但是目前推荐使用vscode，目前会有一些vscode插件辅助你编程 </div>
    <FoldCard title="点击查看vscode说明">
      <button >点击下载VSCode </button>
      <div > 注：这里只是为了方便你下载vscode，如有疑问可以去官网下载</div>
      <button >语言插件下载 </button>
    </FoldCard >
    <div className={aTitle}>我们编写一个数据收集功能。将收集到的数据，传递给服务端。</div>
    <div className={aTitle}>前端部分</div>
    <div >创建一个GetInfos函数组件，这个组件将收集姓名、性别、年龄、地址信息，点击确认后。会将收集的信息传递给服务端</div>
    <div >使用全局的app对象的render方法，渲染GetInfos组件</div>
    <CodeComponent code={GetInfosStr} ></CodeComponent>
    <GetInfos ></GetInfos>
    使用LUI打开index.lab就将执行这个界面程序
    
    <div className={aTitle}>服务端部分</div>
    <div >新建一个文件，如serve.lab。我们会在这个文件中编写服务端代码。</div>
    <CodeComponent code={httpServeStr} ></CodeComponent>
    使用LUI打开serve.lab就将执行这个服务
  </div>
)


 (export {label:"快速入门",key:"start",children:content})