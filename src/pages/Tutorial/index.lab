(import {Collapse} from "../../components/Collapse/index.lab")
(import {Menu} from "../../components/Menu/index.lab")
(import 1home from "./pages/1home.lab")
(import 2baseUse from "./pages/2baseUse.lab")

(let TutorialStyle (style.create  {
      width:"100%",
      height:"100%",
      display:"flex",
  }))
(let TutorialMenuBox (style.create  {
      width:"300px",
      height:"100%",
      padding:"20px",
  }))

(let TutorialContentStyle (style.create  {
    flexGrow:"1",
    height:"100%",
    padding:"20px",
    border:"1px",
    overflow:"scroll"
  }))
(let TutorialContentMenuBox (style.create  {
    width:"300px",
    height:"100%",
    padding:"20px",
  }))
  

(let Preface [1home])

(let UIMenu [
      2baseUse
      {label:"Alert警告提示",key:"2",children:<div>警告提示，展现需要关注的信息。</div>},
   
    ])

    

(let ServeMenu [
  {label:"Collapse折叠面板",key:"1",children:<div>对复杂区域进行分组和隐藏，保持页面的整洁。手风琴 是一种特殊的折叠面板，只允许单个内容区域展开。</div>},
])




(function (Tutorial props propMethod)
  (let state (propMethod.initState {
      content:undefined,
      setState:(lambda (key x)
        (set state[key] x)
        (propMethod.update )
      )
    }
  ))

  (let action (propMethod.initState {
      changeContent:(lambda (newContent)
        (state.setState  "content" newContent)
      )
    }
  ))

  (let memus (propMethod.initState {
      TopMemu:[
        {label:"序言",key:"1",children: <Menu onChange={action.changeContent} data={Preface}></Menu>},
        {label:"语言教程",key:"2",children: <Menu onChange={action.changeContent} data={UIMenu}></Menu>},
        {label:"API文档",key:"3",children:<Menu onChange={action.changeContent} data={ServeMenu}></Menu>},
      ],
      setState:(lambda (key x)
        (set state[key] x)
        (propMethod.update )
      )
    }
  ))

  <div className={TutorialStyle}>
      <div className={TutorialMenuBox}>
        <Collapse data={memus.TopMemu} ></Collapse>
      </div>
      <div className={TutorialContentStyle}>{state.content}</div >
  </div>
)

// <div className={TutorialContentMenuBox}>
//   <Collapse data={AllMenu}></Collapse>
// </div>

(export {Tutorial})