(import {MainShow} from "./Main/Mainshow.lab")
(import {LABPart} from "./LABPart/index.lab")
(import {LUIPart} from "./LUIPart/index.lab")
(import {Table} from "../../container/table/index.lab")


(let LUIPageStyle (style.create  {
    width:"100%",
    height:"100%",
    overflow:"scroll"
}))

(function (HttpTest props propsMethods)
  (let state (propsMethods.initState 
      {
        someTxt:"原始文字",
        test:"原始文字",
        setState:(lambda (key value) 
                        (set (get state key) value)
                        (propsMethods.update)
                 )
      }
    )
  )
  (propsMethods.afterMounted (lambda (x)

      // (let aHttpRequest (new HttpRequest))
      // (set aHttpRequest.method "get")
      // (set aHttpRequest.url "https://example.com")
      // (aHttpRequest.sendAsync (lambda (res) 
      //   (state.setState "someTxt" res.body )
      //   )
      // )

      (sleep (lambda ()
          (state.setState "someTxt" "https://example.com" )
          )
        1
      )
      
    )
  )

  <div>{state.someTxt}</div>
)

(let x 10)
(let y 10)
(let canvasDOm 0)

(function  (CanvasTest props propsMethods)
   <div>
    <canvas
          ref={(lambda (x)
            (set canvasDOm x)
          )}
          style={{width:"400px",height:"400px", border:"1px",backgroundColor: "40|80|144|255",}}
          width="400" height="400"></canvas>
          <button
            onClick={(lambda ()
                            (console.log "-----canvas---")
                            (set x (+ x 3))
                            (set y (+ y 7))
                            (for (let i 0) (less i 800) (+= i 10)
                                (for (let k 0) (less k 800) (+= k 10)
                                    (canvasDOm.point [i k])
                                )
                            )

                            (for (begin (let i 0) (let length 1) ) (less i 800) (+= i 40)
                                (+= length 1)
                                (for (let a_k 0) (less a_k 800) (+= a_k 40)
                                    (canvasDOm.arc [i (+ a_k 5)] length)
                                )
                            )
                            
                            (propsMethods.update  )
                        )
                    }
          >绘制按钮</button>
   </div>
)

(function (UIItems )
  <div >
    <checkboxGroup >
        <checkbox label="test1" value={1}></checkbox>
        <checkbox label="test2" value={2}></checkbox>
        <checkbox label="test3" value={3}></checkbox>
    </checkboxGroup >
     <div style={{width:"200px",backgroundColor:"25|129|34|255", height:"40px",}}>123</div>
    <select style={{width:"200px"}}>
        <option value="1" label="one" >----one</option>
        <option value="2" label="two" >two---</option>
    </select >
    <div style={{width:"200px",backgroundColor:"25|129|34|255", height:"40px",}}>123</div>
     <select style={{width:"200px"}}>
        <option value="1" label="one" >----one</option>
        <option value="2" label="two" >two---</option>
    </select >
  </div>
)

(function (Home props)
  <div className={LUIPageStyle}>
      <MainShow></MainShow>
      <LABPart></LABPart>
      <LUIPart></LUIPart>
      <HttpTest></HttpTest>
      <UIItems></UIItems>
      <CanvasTest></CanvasTest>
      <Table></Table>
  </div>
)
    
(export { Home })