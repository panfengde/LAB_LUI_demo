(import {CodeComponent} from "../../../container/CodeComponent/index.lab")
(import {codeString} from "./aCode.lab")

(let HttpServeStyle (style.create  {
    width:"100%",
    height:"500px",
    display:"flex",
    flexDirection:"column",
    alignItems:"alignCenter",
    backgroundColor:"35|39|47|255",
    padding:"20px",
}))

(function (HttpServe props)
    <div className={HttpServeStyle}>
        <div style={{fontSize:"24px",margin:"10px 0px 20px 0px"}} >创建并运行一个http服务</div>
        <div style={{display:"flex",alignItems:"alignCenter",justifyContent:"center",width:"1100px"}} >
            <div style={{width:"50%"}} >
                <CodeComponent code={codeString} ></CodeComponent>
            </div>
        </div>
    </div>
)


(export {
  HttpServe 
})