(let x 10)
(let y 10)
(let canvasDOm 0)
(let ModelDOm 0)

(function  (ModelDemo props propsMethods)
   <div>
          <button
            onClick={(lambda ()
                  (ModelDOm.rotate 10 [0 1 0])
                           
              )} >旋转模型</button>
            <button
              onClick={(lambda ()
                   (ModelDOm.scale  [1.1 1.1 1.1])  
              )} >放大模型</button>
            <button
              onClick={(lambda ()
                    (ModelDOm.translate  [1 1 0])
              )} >移动模型</button>
           <button
              onClick={(lambda ()
                    (ModelDOm.reset )
                )} >重制</button>
          <model
            ref={(lambda (x)
                (set ModelDOm x)
            )}
            style={{width:"400px",height:"400px", border:"1px",backgroundColor: "40|80|144|255",display:"block"}}
            width="400" height="400"></model>
   </div>
)

(export {
  ModelDemo:ModelDemo
})