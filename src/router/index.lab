(import {storeState} from "../store/index.lab")
(import {Home} from "../pages/home/index.lab")
(import {DemoPage} from "../pages/demoPage/index.lab")
(import {Tutorial} from "../pages/Tutorial/index.lab")
(import {IssuesPage} from "../pages/Issues/index.lab")

(function (Go )
  <div>GoGo</div>
)

(function (HttpTest props propsMethods)
  (let state (propsMethods.initState 
      {
        someTxt:"原始文字",
        test:"原始文字",
        setState:(lambda (key value) 
                        (set (get state key) value)
                        (propsMethods.update)
                 )
      }
    )
  )

  (propsMethods.afterMounted (lambda (x)
      
      (sleep (lambda ()
          (state.setState "someTxt" "https://example.com" )
          )
        1
      )
      
    )
  )

  <div>{state.someTxt}</div>
)




(function (Router )
  (cond
     ((== storeState.type "home")  <Home></Home>)
     ((== storeState.type "serve")  <DemoPage></DemoPage>)
     ((== storeState.type "test")  <div>404</div>)
     ((== storeState.type "tutorial")  <Tutorial></Tutorial>)
     ((== storeState.type "issues")  <IssuesPage></IssuesPage>)
     (else <div>404</div>)
  )
)

(export {Router:Router})