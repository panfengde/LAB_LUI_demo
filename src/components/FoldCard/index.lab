
(let aTitle (style.create  {
   color:"155|155|55|255",
   display:"inlineBlock"
}))


(let FoldCardBox (style.create  {
   margin:"10px",
   padding:"10px",
   border:"1px",
}))

(function (FoldCard props propMethod)

  (let state (propMethod.initState {
    show: false
  }))

  (function (changeAction)
    (if state.show
      (set state.show false)
      (set state.show true)
    )
    (propMethod.update )
  )

  <div className={FoldCardBox}>
    <div className={aTitle} onClick={changeAction}>{props.title}</div>
    {(if  state.show
          <div>{props.children}</div>
    )}
  </div>
)

(export {FoldCard})